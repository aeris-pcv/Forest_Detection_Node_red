INFLUX_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_PASSWORD
INFLUX_ORG=forestfire
INFLUX_BUCKET=telemetry
INFLUX_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=
