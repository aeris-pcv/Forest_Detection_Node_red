  {
    "id": "history",
    "type": "function",
    "z": "fire",
    "name": "Store bounded history",
    "x": 690,
    "y": 290,
    "wires": [
      []
    ],
    "outputs": 1,
    "noerr": 0,
    "func": "let h=flow.get(\"history\")||[];h.push(msg.payload);if(h.length>720)h=h.slice(-720);flow.set(\"history\",h);return null;"
  },
  {
    "id": "cloud",
    "type": "function",
    "z": "fire",
    "name": "ThingSpeak rate limit",
    "x": 910,
    "y": 290,
    "wires": [
      [
        "http"
      ]
    ],
    "outputs": 1,
    "noerr": 0,
    "func": "const p=msg.payload;\nconst key=env.get(\"THINGSPEAK_WRITE_KEY\");\nif (!key) return null;\nconst now=Date.now();\nif (now-(flow.get(\"lastCloud\")||0)<16000) return null;\nflow.set(\"lastCloud\",now);\nmsg.method=\"POST\";msg.url=\"https://api.thingspeak.com/update.json\";\nmsg.headers={\"Content-Type\":\"application/x-www-form-urlencoded\"};\nmsg.payload=\"api_key=\"+encodeURIComponent(key)+\n \"&field1=\"+encodeURIComponent(p.temperature_c??\"\")+\n \"&field2=\"+encodeURIComponent(p.humidity??\"\")+\n \"&field3=\"+Number(p.flame)+\"&field4=\"+Number(p.motion)+\n \"&field5=\"+({OFF:0,SAFE:1,WARNING:2,ALARM:3}[p.state])+ \n \"&field6=\"+p.flame_ao+\"&field7=\"+p.servo_deg+\"&field8=\"+Number(p.muted);\nreturn msg;"
  },
  {
    "id": "http",
    "type": "http request",
    "z": "fire",
    "name": "Public ThingSpeak channel",
    "x": 1120,
    "y": 290,
    "wires": [
      [
        "cloud_debug"
      ]
    ],
    "method": "use",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": []
  },
  {
    "id": "cloud_debug",
    "type": "debug",
    "z": "fire",
    "name": "Cloud response/errors",
    "x": 1320,
    "y": 290,
    "wires": [
      []
    ],
    "active": true,
    "tosidebar": true,
    "complete": "payload",
    "targetType": "msg"
  },
  {
    "id": "influx",
    "type": "function",
    "z": "fire",
    "name": "Build InfluxDB line protocol",
    "x": 690,
    "y": 340,
    "wires": [
      [
        "influx_http"
      ]
    ],
    "outputs": 1,
    "noerr": 0,
    "func": "const p=msg.payload, token=env.get(\"INFLUX_TOKEN\");\nif (!token) { node.warn(\"INFLUX_TOKEN is not configured\"); return null; }\nconst org=env.get(\"INFLUX_ORG\")||\"forestfire\", bucket=env.get(\"INFLUX_BUCKET\")||\"telemetry\";\nconst fields=[];\nfor (const [key,value] of Object.entries({temperature_c:p.temperature_c,humidity:p.humidity}))\n  if (typeof value===\"number\" && Number.isFinite(value)) fields.push(key+\"=\"+value);\nfields.push(\"flame_ao=\"+Math.round(p.flame_ao)+\"i\");\nfields.push(\"flame=\"+p.flame,\"motion=\"+p.motion,\"muted=\"+p.muted);\nfields.push(\"servo_deg=\"+Math.round(p.servo_deg)+\"i\");\nfields.push(\"state_code=\"+({OFF:0,SAFE:1,WARNING:2,ALARM:3}[p.state])+\"i\");\nmsg.method=\"POST\";\nmsg.url=\"http://influxdb:8086/api/v2/write?org=\"+encodeURIComponent(org)+\"&bucket=\"+encodeURIComponent(bucket)+\"&precision=ns\";\nmsg.headers={\"Authorization\":\"Token \"+token,\"Content-Type\":\"text/plain; charset=utf-8\"};\nmsg.payload=\"forest_fire,source=\"+p.source+\" \"+fields.join(\",\");\nreturn msg;"
  },
  {
    "id": "influx_http",
    "type": "http request",
    "z": "fire",
    "name": "Write telemetry to InfluxDB",
    "x": 960,
    "y": 340,
    "wires": [
      [
        "influx_result"
      ]
    ],
    "method": "use",
    "ret": "txt",
    "paytoqs": "ignore",
    "url": "",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": []
  },
  {
    "id": "influx_result",
    "type": "function",
    "z": "fire",
    "name": "Check InfluxDB result",
    "x": 1200,
    "y": 340,
    "wires": [
      []
    ],
    "outputs": 1,
    "noerr": 0,
    "func": "if(msg.statusCode!==204) node.warn(\"InfluxDB write failed: HTTP \"+msg.statusCode+\" \"+String(msg.payload).slice(0,200));return null;"
  },
  {
    "id": "alert_decision",
    "type": "function",
    "z": "fire",
    "name": "State-change LINE alert",
    "x": 700,
    "y": 390,
    "wires": [
      [
        "line_build"
      ]
    ],
    "outputs": 1,
    "noerr": 0,
    "func": "const p=msg.payload, key=\"lastAlertState_\"+p.source;\nconst previous=flow.get(key);\nif (previous===p.state) return null;\nflow.set(key,p.state);\nif (p.state===\"OFF\" || (previous===undefined && p.state===\"SAFE\")) return null;\nconst details=\"Temperature \"+(p.temperature_c===null?\"unavailable\":p.temperature_c+\" C\")+\n  \", humidity \"+(p.humidity===null?\"unavailable\":p.humidity+\"%\")+\n  \", flame \"+(p.flame?\"detected\":\"clear\")+\".\";\nmsg.payload=\"Forest Fire \"+p.source.toUpperCase()+\": \"+p.state+\". \"+details+\n  (p.state===\"ALARM\"?\" Inspect the site immediately.\":\n   p.state===\"WARNING\"?\" Check heat and dry conditions.\":\" Conditions recovered; continue monitoring.\");\nreturn msg;"
  },
  {
    "id": "line_build",
    "type": "function",
    "z": "fire",
    "name": "Build LINE push request",
    "x": 940,
    "y": 390,
    "wires": [
      [
        "line_http"
      ]
    ],
    "outputs": 1,
    "noerr": 0,
    "func": "const token=env.get(\"LINE_CHANNEL_ACCESS_TOKEN\"), to=env.get(\"LINE_USER_ID\");\nif (!token || !to) { node.warn(\"LINE credentials are not configured\"); return null; }\nmsg.method=\"POST\";msg.url=\"https://api.line.me/v2/bot/message/push\";\nmsg.headers={\"Authorization\":\"Bearer \"+token,\"Content-Type\":\"application/json\"};\nmsg.payload={to:to,messages:[{type:\"text\",text:String(msg.payload).slice(0,5000)}]};\nreturn msg;"
  },
  {
    "id": "line_http",
    "type": "http request",
    "z": "fire",
    "name": "Push LINE alert",
    "x": 1140,
    "y": 390,
    "wires": [
