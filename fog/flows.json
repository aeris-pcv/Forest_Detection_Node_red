  {
    "id": "parse",
    "type": "json",
    "z": "fire",
    "name": "Parse JSON",
    "x": 300,
    "y": 140,
    "wires": [
      [
        "validate"
      ]
    ],
    "property": "payload",
    "action": "obj",
    "pretty": false
  },
  {
    "id": "validate",
    "type": "function",
    "z": "fire",
    "name": "Validate and select source",
    "x": 480,
    "y": 140,
    "wires": [
      [
        "split",
        "history",
        "influx",
        "alert_decision"
      ]
    ],
    "func": "const p=msg.payload;\nif (!p || ![\"esp32\",\"twin\"].includes(p.source) ||\n    ![\"OFF\",\"SAFE\",\"WARNING\",\"ALARM\"].includes(p.state) ||\n    typeof p.flame!==\"boolean\" || typeof p.motion!==\"boolean\" ||\n    (p.temperature_c!==null && typeof p.temperature_c!==\"number\") ||\n    (p.humidity!==null && typeof p.humidity!==\"number\")) return null;\nconst s=flow.get(\"selectedSource\") || \"twin\";\nif (p.source!==s) return null;\np.received_at=Date.now();\nflow.set(\"latest\",p);\nmsg.payload=p;\nreturn msg;",
    "outputs": 1,
    "noerr": 0
  },
  {
    "id": "split",
    "type": "function",
    "z": "fire",
    "name": "Dashboard and cloud fields",
    "x": 670,
    "y": 110,
    "wires": [
      [
        "temp",
        "hum",
        "flame",
        "state",
        "recommend",
        "cloud"
      ]
    ],
    "outputs": 1,
    "noerr": 0,
    "func": "const p=msg.payload;\nmsg.temperature=p.temperature_c;\nmsg.humidity=p.humidity;\nmsg.flame_label=p.flame ? \"FLAME DETECTED\" : \"clear\";\nmsg.state_label=p.state + (p.motion && p.state===\"ALARM\" ? \" - PERSON NEAR\" : \"\");\nmsg.recommendation=p.state===\"ALARM\" ? \"Alarm active. Inspect site; mute only after checking.\" :\n  p.state===\"WARNING\" ? \"Elevated risk. Check heat and dry conditions.\" : \"Conditions normal. Keep monitoring.\";\nreturn msg;"
  },
